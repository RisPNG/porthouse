[Unit]
Description=Porthouse client, plugs in USB devices that other computers share
Documentation=https://github.com/RisPNG/porthouse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe vhci-hcd
ExecStart=/usr/bin/porthouse-clientd run
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
StateDirectory=porthouse
StateDirectoryMode=0700
RuntimeDirectory=porthouse
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
