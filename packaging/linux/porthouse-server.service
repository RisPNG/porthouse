[Unit]
Description=Porthouse server, shares this computer's USB devices
Documentation=https://github.com/RisPNG/porthouse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/porthouse-server run
# SIGTERM makes the server hand every claimed device back to the host before it exits.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
StateDirectory=porthouse
StateDirectoryMode=0700
RuntimeDirectory=porthouse
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
