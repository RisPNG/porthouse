# Maintainer: Ris Peng <hello@rispeng.com>
pkgname=porthouse
pkgver=0.2.0
pkgrel=1
pkgdesc='Use USB devices that are plugged into other computers, and share yours'
arch=('x86_64')
url='https://github.com/RisPNG/porthouse'
license=('MIT OR Apache-2.0')
depends=('qt6-base' 'qt6-declarative' 'kmod' 'systemd')
makedepends=('cargo' 'cmake' 'ninja')
options=('!lto')
install=porthouse.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen -p porthouse-server -p porthouse-client
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DPORTHOUSE_RUST_BIN_DIR="$PWD/target/release"
  cmake --build build
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
